                <field name="NUM">2</field>
              </block>
            </value>
            <statement name="DO2">
              <block type="block_with_textarea" id="yaoyao_55">
                <field name="input">yy_send_command(0x02); // 停止任务</field>
              </block>
            </statement>
            <value name="IF3">
