    <statement name="STACK">
      <block type="block_with_textarea" id="yaoyao_49">
        <field name="input">set_state_enter_wakeup(8589934); // 8589.934秒，SDK安全上限</field>
        <next>
          <block type="controls_switch_case" id="yaoyao_50">
            <mutation elseif="22"></mutation>
            <value name="IF0">
