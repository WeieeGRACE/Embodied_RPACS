              </block>
            </value>
            <statement name="DO4">
              <block type="block_with_textarea" id="yaoyao_59">
                <field name="input">yy_send_command(0x02); // 停止</field>
              </block>
            </statement>
            <value name="IF5">
              <block type="math_number" id="yaoyao_60">
                <field name="NUM">5</field>
              </block>
            </value>
