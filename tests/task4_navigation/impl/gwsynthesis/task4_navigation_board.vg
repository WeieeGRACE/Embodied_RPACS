module tof_driver_1 (
  clk_50m_d,
  n773_6,
  \channels[2].trigger ,
  tof_right_scl_in,
  tof_right_sda_in,
  \channels[2].done ,
  \channels[2].ok ,
  \channels[2].busy ,
  xshut_n_6,
  scl_6,
  sda_6,
  \channels[2].err ,
  \channels[2].mm ,
  \channels[2].mask ,
  \channels[2].id 
)
;
input clk_50m_d;
input n773_6;
input \channels[2].trigger ;
input tof_right_scl_in;
input tof_right_sda_in;
output \channels[2].done ;
output \channels[2].ok ;
output \channels[2].busy ;
output xshut_n_6;
output scl_6;
output sda_6;
