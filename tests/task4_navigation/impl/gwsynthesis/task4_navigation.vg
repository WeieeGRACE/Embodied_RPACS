module task4_navigation_top (
  clk_50m,
  reset_n,
  key_start_n,
  key_stop_n,
  key_estop_n,
  calibration_done,
  geometry_ok,
  imu_valid,
  encoder_valid,
  encoder_left_mm,
  encoder_right_mm,
  imu_yaw_delta_mdeg,
  encoder_yaw_delta_mdeg,
  tof_valid,
  tof_update,
  tof_front_mm,
  tof_left_mm,
  tof_right_mm,
  route_id,
  pose_x_um,
  pose_y_um,
  pose_yaw_mdeg,
  velocity_l_mm_s,
  velocity_r_mm_s,
  nav_state,
  fault_code,
  accepted_tof,
  tof_fresh,
  tof_age_front,
  tof_age_left,
  tof_age_right,
  nav_done,
  nav_blocked,
  nav_range_fault,
  nav_input_fault,
  drive_enable
)
;
input clk_50m;
