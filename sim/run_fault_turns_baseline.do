# Compile the frozen PRE-FIX baseline sources (git HEAD) for the fault-injection runs.
# The working tree src/ is being changed by the RTL fix; this compiles an
# untouched copy of the version the user actually reported the fault on.
onerror {quit -code 1 -force}
if {![file exists sim/work_fault_baseline]} {vlib sim/work_fault_baseline}
vmap fault_lib sim/work_fault_baseline
vlog -sv -work fault_lib records/fault_injection/baseline_src/src/obstacle/obstacle_route.v records/fault_injection/baseline_src/src/obstacle/obstacle_sensors.v records/fault_injection/baseline_src/src/obstacle/obstacle_command.v records/fault_injection/baseline_src/src/obstacle/system_dispatch.v records/fault_injection/baseline_src/src/robot_system_top.v records/fault_injection/baseline_src/src/asr/system_motion.v records/fault_injection/baseline_src/src/asr/asr_uart_rx.v records/fault_injection/baseline_src/src/asr/asr_packet_tx.v records/fault_injection/baseline_src/src/asr/asr_feedback.v records/fault_injection/baseline_src/src/ui/system_keys.v records/fault_injection/baseline_src/src/ui/system_menu.v records/fault_injection/baseline_src/src/ui/system_pages.v records/fault_injection/baseline_src/src/ui/system_oled_text.v records/fault_injection/baseline_src/src/tof/tof_driver.v records/fault_injection/baseline_src/src/tof/tof_i2c.v records/fault_injection/baseline_src/src/tof/tof_page.v records/fault_injection/baseline_src/src/motor/motion_control_and_mode_fsm.v records/fault_injection/baseline_src/src/motor/dual_ab_quadrature_encoder.v records/fault_injection/baseline_src/src/motor/speed_measurement_and_velocity_filter.v records/fault_injection/baseline_src/src/motor/dual_speed_pi_pid_controller.v records/fault_injection/baseline_src/src/motor/pwm_and_startup_ramp.v records/fault_injection/baseline_src/src/motor/tb6612_driver_interface.v records/fault_injection/baseline_src/src/imu/imu_attitude_fixed.v records/fault_injection/baseline_src/src/imu/attitude_angle_to_digits.v records/fault_injection/baseline_src/src/imu/oled_i2c_write_byte.v records/fault_injection/baseline_src/src/imu/imu660ra_driver.v records/fault_injection/baseline_src/src/imu/imu660ra_spi_master.v records/fault_injection/baseline_src/src/imu/imu660ra_config_rom.v records/fault_injection/baseline_src/src/uart/uart_tx.v records/fault_injection/baseline_src/src/uart/system_event_logger.v
